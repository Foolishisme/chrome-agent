# Select the active profile in the side panel.
VITE_LLM_PROFILE=external

# Local profile: OpenAI-compatible backend.
VITE_LLM_LOCAL_PROVIDER=openai-compatible
VITE_LLM_LOCAL_API_KEY=
VITE_LLM_LOCAL_BASE_URL=http://localhost:11434/v1
VITE_LLM_LOCAL_MODEL=qwen3.5-35b
VITE_LLM_LOCAL_SIMPLE_MODEL=qwen3.5-35b
VITE_LLM_LOCAL_SIMPLE_MODEL_FALLBACK=qwen3.5-35b

# External profile: Gemini, DeepSeek, OpenAI-compatible APIs, or hosted providers.
VITE_LLM_EXTERNAL_PROVIDER=gemini
VITE_LLM_EXTERNAL_API_KEY=
VITE_LLM_EXTERNAL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
VITE_LLM_EXTERNAL_MODEL=gemini-2.0-flash
VITE_LLM_EXTERNAL_SIMPLE_MODEL=gemini-3.1-flash-lite-preview
VITE_LLM_EXTERNAL_SIMPLE_MODEL_FALLBACK=gemini-2.5-flash-lite

# Backward-compatible aliases still supported by the runtime:
# LOCAL_MODEL_API_URL, LOCAL_MODEL_API_KEY, LOCAL_MODEL_NAME
# VITE_LLM_PROVIDER, VITE_LLM_API_KEY, VITE_LLM_BASE_URL, VITE_LLM_MODEL
# VITE_GEMINI_API_KEY, VITE_GEMINI_BASE_URL, VITE_GEMINI_MODEL
