{
  "name": "browser-agent-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:unused": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "lint": "eslint .",
    "check:fast": "npm run typecheck && npm run lint && npm test",
    "check:unused": "knip --include files,dependencies,unlisted,unresolved",
    "check:unused:exports": "knip --exports --no-exit-code",
    "check:deps": "depcruise --config .dependency-cruiser.cjs src",
    "check:hygiene": "powershell -ExecutionPolicy Bypass -File scripts/check-repo-hygiene.ps1",
    "check:legacy": "powershell -ExecutionPolicy Bypass -File scripts/check-no-legacy-refs.ps1",
    "check:docs": "powershell -ExecutionPolicy Bypass -File scripts/check-current-state-docs.ps1",
    "check:change-size": "powershell -ExecutionPolicy Bypass -File scripts/check-change-size.ps1",
    "check:repo": "npm run check:unused && npm run check:deps && npm run check:hygiene && npm run check:legacy && npm run check:docs",
    "check": "npm run check:fast && npm run check:repo"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "aria-query": "^5.3.2",
    "dom-accessibility-api": "^0.7.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.0.321",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^10.3.0",
    "jsdom": "^26.0.0",
    "knip": "^6.12.2",
    "typescript": "^5.8.3",
    "vite": "^7.3.3",
    "vitest": "^3.2.4"
  }
}
