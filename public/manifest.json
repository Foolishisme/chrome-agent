{
  "manifest_version": 3,
  "name": "浏览器 Agent MVP",
  "version": "0.1.0",
  "description": "京东购物浏览器 Agent MVP，包含 Side Panel、运行时编排与 Gemini 决策。",
  "permissions": ["sidePanel", "tabs", "activeTab"],
  "host_permissions": ["https://www.jd.com/*", "https://search.jd.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "打开浏览器 Agent MVP"
  },
  "content_scripts": [
    {
      "matches": ["https://www.jd.com/*", "https://search.jd.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
